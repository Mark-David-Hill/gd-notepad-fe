# Backend API base URL (Flask), e.g. http://localhost:8086.
# Leave unset to build the read-only demo: no API calls, no login,
# collections load from public Google Sheets only.
VITE_API_BASE_URL=http://localhost:8086

# Public Google Sheet that lists external collections (the catalog).
# Defaults to the demo catalog sheet when unset.
VITE_GOOGLE_SHEET_ID=1aYK-0RBzHnzvZKmVjWwwbfmPqY29f6SnyjfT8InQf10
